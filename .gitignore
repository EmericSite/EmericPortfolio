# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# editors
.idea/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright / local screenshots
.playwright-mcp/

# sources fournies par Emeric, hors dépôt : seules leurs versions publiées y entrent.
ASSETS_EMERIC/

# content: the .yml files are versioned, the source media are not.
# Only their optimized versions, in public/, go online.
/content/projets/**/*.png
/content/projets/**/*.jpg
/content/projets/**/*.jpeg
/content/projets/**/*.webp
/content/projets/**/*.avif
/content/projets/**/*.tif
/content/projets/**/*.tiff
/content/projets/**/*.gif
/content/projets/**/*.mp4
/content/projets/**/*.mov
/content/projets/**/*.webm
