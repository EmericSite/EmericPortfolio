# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# editors
.idea/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright / local screenshots
.playwright-mcp/

# sources fournies par Emeric, hors dépôt : seules leurs versions publiées y entrent.
ASSETS_EMERIC/

# content/ est versionné en entier, médias compris : c'est la source de vérité
# du site, et un clone doit suffire à republier. Les rushes bruts, eux, restent
# dans ASSETS_EMERIC/ ci-dessus.
