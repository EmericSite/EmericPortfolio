# Formulaire de contact — envoi des mails via Resend (https://resend.com)
# Copier ce fichier en .env.local pour le développement, et déclarer les mêmes
# variables sur Vercel : vercel env add <NOM>

# Clé API Resend (tableau de bord > API Keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Adresse qui reçoit les messages du formulaire
CONTACT_TO_EMAIL=hello@emericressy.com

# Expéditeur. Doit appartenir à un domaine vérifié dans Resend.
# Tant que le domaine n'est pas vérifié, utiliser onboarding@resend.dev
# (Resend ne l'accepte alors que vers l'adresse du compte).
CONTACT_FROM_EMAIL=site@emericressy.com
